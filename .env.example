# Supabase (server-only; never expose the service role key to the client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret gating /admin (the live experiment-settings dashboard) and
# /api/admin/*. Required -- with this unset, /admin rejects every request
# rather than being open by default. This is a temporary internal tool, not
# participant-facing; treat the value like a password.
ADMIN_DASHBOARD_SECRET=change-me

# LLM providers -- set the key(s) for whichever provider(s) your MODEL_*_PROVIDER
# vars below select. Both can be set at once if heavy/light use different providers.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Heavy / light model selection. Provider is "openai" or "anthropic". Heavy
# is o4-mini, an actual OpenAI reasoning model (does internal step-by-step
# reasoning before answering, unlike gpt-4o) -- chosen for the scheduling
# task, which standard chat models are unreliable at even with a good
# prompt. o4-mini over o3: notably cheaper/faster to actually run while
# still being a real reasoning model, not a cross-generation quality gap
# used just to fake a difference. Light stays gpt-4o-mini, a standard chat
# model, so heavy vs. light is genuinely reasoning-vs-not, not just
# same-architecture-different-size. See src/lib/providers/openai.ts
# isReasoningModel() for the request-shape differences this requires
# (max_completion_tokens instead of max_tokens, no temperature/top_p/
# presence_penalty/seed, reasoning_effort instead -- see /admin).
MODEL_HEAVY_PROVIDER=openai
MODEL_HEAVY_ID=o4-mini
MODEL_LIGHT_PROVIDER=openai
MODEL_LIGHT_ID=gpt-4o-mini

# Reasoning effort for heavy (o4-mini) -- "low" | "medium" | "high". Higher
# spends more tokens/time reasoning before answering; "high" is what makes
# heavy actually reliable at the scheduling puzzle rather than just slower.
# No equivalent for light (gpt-4o-mini isn't a reasoning model).
MODEL_HEAVY_REASONING_EFFORT=high

# Heavy's artificial slowdown: after generating, it sleeps
# extraDelayBaseSec +/- extraDelayJitterSec (uniformly random) -- e.g. the
# defaults below give a flat ~2-4s pause regardless of response length, not
# proportional to token count. This is what makes the "convenience"
# condition's "takes noticeably longer" nudge copy true rather than just
# claimed. Light has no equivalent (0 base, 0 jitter).
MODEL_HEAVY_EXTRA_DELAY_BASE_SEC=3
MODEL_HEAVY_EXTRA_DELAY_JITTER_SEC=1

# Sampling temperature per model. OpenAI's scale is 0-2 (default 1);
# Anthropic's is 0-1 (clamped automatically in src/lib/providers/anthropic.ts).
# HEAVY_TEMPERATURE/HEAVY_TOP_P below have NO EFFECT now that heavy
# (o4-mini) is a reasoning model -- the API rejects these params outright
# for o-series models. Kept only so /admin's shared per-model fields stay
# uniform; use MODEL_HEAVY_REASONING_EFFORT above instead to tune heavy's
# behavior. Light (gpt-4o-mini, a standard chat model) still uses these
# normally: light runs hot (1.5) to introduce real quality variance, only
# workable paired with the aggressive top_p cut below.
MODEL_HEAVY_TEMPERATURE=0.7
MODEL_LIGHT_TEMPERATURE=1.5

# Nucleus sampling (top_p) -- see the no-effect-on-heavy note above.
MODEL_HEAVY_TOP_P=1.0
MODEL_LIGHT_TOP_P=0.5

# Energy-per-1000-tokens figures (Wh) used for the carbon estimate and shown
# in the nudge copy under the model toggle.
#
# DELIBERATE MISMATCH: heavy's number below is sourced from o3's published
# stats, NOT o4-mini's (the model actually generating heavy's responses --
# see MODEL_HEAVY_ID above). OpenAI has never disclosed o4-mini's
# architecture, and third-party research (which extrapolates energy from
# model size/hardware) has no way to estimate it either -- there's no
# defensible o4-mini-specific number to put here, only a normalized "ranks
# well vs. other reasoning models" efficiency score with no absolute Wh
# value. o3 is well-documented (research puts reasoning models at ~10-70x a
# standard gpt-4o-class query; 15 Wh/1k tokens here is the conservative low
# end of that range) and is the closest real reference point for "a
# reasoning model of this class." Practical effect: the nudge shown to
# participants reflects o3-level environmental cost, while the actual
# generation running underneath is the cheaper/lower-impact o4-mini -- i.e.
# the displayed heavy-vs-light gap is a real upper bound for this class of
# model, not a measurement of this specific deployment's actual footprint.
# Light (~0.2 Wh) is unchanged -- see prior git history for its sourcing.
MODEL_HEAVY_ENERGY_WH_PER_1K=15
MODEL_LIGHT_ENERGY_WH_PER_1K=0.2

# Price per 1,000 tokens, in cents, charged against the participation credit
# under the "variable" and "fixed" pricing conditions (the "free" condition
# never charges regardless of these values).
#
# Same deliberate mismatch as the energy figure above: heavy's 13 cents/1k
# is derived from o3's actual published API price ($2/$8 per 1M input/output
# tokens, ~13x gpt-4o-mini's blended $0.375/1M) -- not o4-mini's real price,
# which is lower. The nudge's cost comparison is scaled to o3-class pricing;
# the app's actual OpenAI bill for heavy's generations will run cheaper than
# what's shown to participants.
MODEL_HEAVY_PRICE_CENTS_PER_1K=13
MODEL_LIGHT_PRICE_CENTS_PER_1K=1

# Grid carbon intensity (g CO2 / kWh) and data-center water use (mL / kWh)
# used to convert estimated energy into CO2 and water figures. 425 is IEA's
# ~2025-2026 global average (445 in 2024, declining ~3.7%/yr); 1900 is the
# average data-center water-usage-effectiveness figure (Patterns/Cell Press
# 2025) -- both global averages, not specific to any one data center/region.
GRID_CARBON_INTENSITY_G_PER_KWH=425
WATER_ML_PER_KWH=1900

# Hypothetical group size used to scale the per-token heavy/light comparison
# into a tangible aggregate for the "if everyone did this" nudge copy shown
# on the model toggle and the fixed-plan picker. Default is OpenAI's own
# reported ChatGPT weekly-active-user count (900 million, Feb 2026) used
# purely as a relatable reference scale -- not a claim that this app itself
# has that many users.
NUDGE_IMPACT_SCALE_USERS=900000000

# Fixed participation credit per session, in cents (e.g. 300 = $3).
FIXED_CREDIT_CENTS=300

# Base URL the cartoon image is hotlinked from -- the app never stores or
# copies the image itself, only the filename (src/lib/cartoons.ts), and
# builds <base>/<filename> at render time. Defaults to a fork of the nextml
# caption-contest-data dataset's gh-pages branch.
CARTOON_IMAGE_BASE_URL=https://raw.githubusercontent.com/hcbrianlee/caption-contest-data/gh-pages/cartoons
