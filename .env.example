# Supabase (server-only; never expose the service role key to the client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM providers -- set the key(s) for whichever provider(s) your MODEL_*_PROVIDER
# vars below select. Both can be set at once if heavy/light use different providers.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Heavy / light model selection. Provider is "openai" or "anthropic".
MODEL_HEAVY_PROVIDER=openai
MODEL_HEAVY_ID=gpt-4o
MODEL_LIGHT_PROVIDER=openai
MODEL_LIGHT_ID=gpt-4o-mini

# Energy-per-1000-tokens figures (Wh) used for the carbon estimate. Heavy
# (~1.0 Wh) is sourced from 2025-2026 published estimates for GPT-4o-class
# inference (~0.3-0.43 Wh per ~300-500 token query -- see "How Hungry is AI?"
# arXiv:2505.09598, Epoch AI). Light (~0.2 Wh) is an extrapolation from that
# figure scaled to gpt-4o-mini's relative size/pricing, not a directly
# published number -- there's no authoritative mini-model-specific study as
# of this writing. Revisit both periodically; this is a fast-moving area.
MODEL_HEAVY_ENERGY_WH_PER_1K=1.0
MODEL_LIGHT_ENERGY_WH_PER_1K=0.2

# Price per 1,000 tokens, in cents, charged against the participation credit
# under the "variable" and "fixed" pricing conditions (the "free" condition
# never charges regardless of these values).
MODEL_HEAVY_PRICE_CENTS_PER_1K=2
MODEL_LIGHT_PRICE_CENTS_PER_1K=1

# Grid carbon intensity (g CO2 / kWh) and data-center water use (mL / kWh)
# used to convert estimated energy into CO2 and water figures. 425 is IEA's
# ~2025-2026 global average (445 in 2024, declining ~3.7%/yr); 1900 is the
# average data-center water-usage-effectiveness figure (Patterns/Cell Press
# 2025) -- both global averages, not specific to any one data center/region.
GRID_CARBON_INTENSITY_G_PER_KWH=425
WATER_ML_PER_KWH=1900

# Fixed participation credit per session, in cents (e.g. 300 = $3).
FIXED_CREDIT_CENTS=300

# Base URL the cartoon image is hotlinked from -- the app never stores or
# copies the image itself, only the filename (src/lib/cartoons.ts), and
# builds <base>/<filename> at render time. Defaults to a fork of the nextml
# caption-contest-data dataset's gh-pages branch.
CARTOON_IMAGE_BASE_URL=https://raw.githubusercontent.com/hcbrianlee/caption-contest-data/gh-pages/cartoons
